# ACTED_IN.roles is an RDF list in the snapshot (order and duplicates kept).
# schema:characterName is a plain multi-valued property: flatten the list.
PREFIX lpg:    <https://example.org/lpg#>
PREFIX t:      <http://neo4j.example/movies/type/>
PREFIX p:      <http://neo4j.example/movies/prop/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <https://schema.org/>

CONSTRUCT { ?r schema:characterName ?character }
WHERE {
  ?r lpg:type t:ACTED_IN ;
     p:roles/rdf:rest*/rdf:first ?character .
}
